{%
  set classes = [
    'stcm-modal',
    'stcm-modal--hidden',
    not paragraph.isPublished() ? 'stcm-modal--unpublished',
    is_front ? 'stcm-modal--is-front',
  ]
%}
<section{{ attributes.addClass(classes) }}>
  <button class="stcm-modal__close-button"></button>

  <div class="stcm-modal__content">
    {% if content.field_modal_par_modal_layout.0 %}
      {{- content.field_modal_par_modal_layout -}}
    {% endif %}

    {% if content.field_modal_banish_text.0 %}
      <button class="stcm-modal__banish-button">{{- content.field_modal_banish_text -}}</button>
    {% endif %}
  </div>
</section>
