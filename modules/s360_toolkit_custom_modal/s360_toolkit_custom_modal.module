<?php

/**
 * @file
 * s360_toolkit_custom_modal.module
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Markup;

/**
 * Implements hook_page_attachments_alter().
 */
function s360_toolkit_custom_modal_page_attachments_alter(array &$attachments) {
  // Attach the "theme" library only when the route is NOT the admin.
  if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
    $attachments['#attached']['library'][] = 's360_toolkit_custom_modal/s360-toolkit-custom-modal.theme';
  }
  // Otherwise attach the "admin" library.
  else {
    $attachments['#attached']['library'][] = 's360_toolkit_custom_modal/s360-toolkit-custom-modal.admin';
  }
}

/**
 * Implements hook_theme().
 */
function s360_toolkit_custom_modal_theme($existing, $type, $theme, $path) {
  $template_path = \Drupal::service('extension.list.module')->getPath('s360_toolkit_custom_modal') . '/templates';

  return [
    'paragraph__modal' => [
      'template' => 'paragraph--modal' ,
      'base hook' => 'paragraph',
      'path' => $template_path,
    ],
    'paragraph__modal__preview' => [
      'template' => 'paragraph--modal--preview' ,
      'base hook' => 'paragraph',
      'path' => $template_path,
    ],
    'paragraph__modal_layout' => [
      'template' => 'paragraph--modal-layout',
      'base hook' => 'paragraph',
      'path' => $template_path,
    ],
    'paragraph__modal_trigger' => [
      'template' => 'paragraph--modal-trigger',
      'base hook' => 'paragraph',
      'path' => $template_path,
    ],
    'paragraph__modal_trigger__preview' => [
      'template' => 'paragraph--modal-trigger--preview',
      'base hook' => 'paragraph',
      'path' => $template_path,
    ],
    'block__custom__modal' => [
      'template' => 'block--custom--modal',
      'base hook' => 'block',
      'path' => $template_path,
    ]
  ];
}

/**
 * Implements hook_preprocess_paragraph__modal().
 */
function s360_toolkit_custom_modal_preprocess_paragraph__modal(&$variables) {
  if (isset($variables['paragraph'])) {
    /** @var \Drupal\paragraph\Entity\Paragraph $paragraph */
    $paragraph = $variables['paragraph'];

    if ($paragraph->hasField('field_modal_trigger')) {
      $field_modal_trigger = $paragraph->get('field_modal_trigger');
    }
    if ($paragraph->hasField('field_modal_scroll_delay')) {
      $field_modal_scroll_delay = $paragraph->get('field_modal_scroll_delay');
    }
    if ($paragraph->hasField('field_modal_timer_delay')) {
      $field_modal_timer_delay = $paragraph->get('field_modal_timer_delay');
    }
    if ($paragraph->hasField('field_modal_frequency')) {
      $field_modal_frequency = $paragraph->get('field_modal_frequency');
    }
    if ($paragraph->hasField('field_modal_style')) {
      $field_modal_style = $paragraph->get('field_modal_style');
    }
    if ($paragraph->hasField('field_modal_position')) {
      $field_modal_position = $paragraph->get('field_modal_position');
    }
    if ($paragraph->hasField('field_modal_header')) {
      $field_modal_header = $paragraph->get('field_modal_header');
    }

    $modal_settings = [];

    if (isset($field_modal_trigger)) {
      $modal_settings['trigger'] = $field_modal_trigger->getString();
    }

    if (isset($field_modal_scroll_delay)) {
      if ($field_modal_scroll_delay->count()) {
        $modal_settings['scroll_delay'] = intval($field_modal_scroll_delay->getString());
      }
    }

    if (isset($field_modal_timer_delay)) {
      if ($field_modal_timer_delay->count()) {
        $modal_settings['timer_delay'] = intval($field_modal_timer_delay->getString());
      }
    }

    if (isset($field_modal_frequency)) {
      $modal_settings['frequency'] = intval($field_modal_frequency->getString());
    }

    if (isset($field_modal_position)) {
      $modal_settings['position'] = $field_modal_position->getString();
    }
    
    if (isset($field_modal_style) && $field_modal_style->count()) {
      $variables['attributes']['class'][] = 'stcm-modal--style-' . $field_modal_style->getString();
    }

    if (isset($field_modal_position) && $field_modal_position->count()) {
      $variables['attributes']['class'][] = 'stcm-modal--position-' . $field_modal_position->getString();
    }

    if (isset($field_modal_header) && $field_modal_header->count()) {
      $field_modal_header_items = $field_modal_header->view();
      $field_modal_header_header_tag = $field_modal_header_items[0];
      $field_modal_header_heading_tag = $field_modal_header_header_tag[0];

      $variables['attributes']['aria-labelledby'] = reset($field_modal_header_heading_tag['#attributes']['id']);
    }

    $variables['attributes']['data-modal-settings'] = json_encode($modal_settings);
    $variables['attributes']['role'] = 'dialog';
    $variables['attributes']['aria-hidden'] = 'true';
  }
}

/**
 * Implements hook_preprocess_paragraph__modal_trigger().
 */
function s360_toolkit_custom_modal_preprocess_paragraph__modal_trigger(&$variables) {
  if (isset($variables['paragraph'])) {
    /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
    $paragraph = $variables['paragraph'];

    if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
      if ($paragraph->hasField('field_modal_trigger_style')) {
        $field_modal_trigger_style = $paragraph->get('field_modal_trigger_style');

        if ($field_modal_trigger_style->count()) {
          $variables['attributes']['class'][] = 'stcm-modal-trigger--' . $field_modal_trigger_style->getString();
        }
      }

      if ($paragraph->hasField('field_modal_trigger_cta')) {
        $field_modal_trigger_cta = $paragraph->get('field_modal_trigger_cta');

        if ($field_modal_trigger_cta->count()) {
          $field_modal_trigger_cta_value = $field_modal_trigger_cta->getValue();
          $field_modal_trigger_cta_value = reset($field_modal_trigger_cta_value);

          $variables['content']['field_modal_trigger_cta'] = [
            '#type' => 'html_tag',
            '#tag' => 'button',
            '#attributes' => [
              'class' => [
                'stcm-modal-trigger__button'
              ],
              'aria-controls' => $field_modal_trigger_cta_value['second'],
            ],
            '#value' => Markup::create('<span>' . $field_modal_trigger_cta_value['first'] . '</span>'),
          ];
        }
      }
    }
  }
}

/**
 * Implements hook_field_widget_paragraphs_form_alter().
 */
function s360_toolkit_custom_modal_field_widget_paragraphs_form_alter(&$element, FormStateInterface &$form_state, $context) {
  if ($element['#paragraph_type'] == 'modal') {
    $field_modal_scroll_delay = &$element['subform']['field_modal_scroll_delay'];
    $field_modal_timer_delay = &$element['subform']['field_modal_timer_delay'];
    $field_modal_banish_text = &$element['subform']['field_modal_banish_text'];
    $field_modal_frequency = &$element['subform']['field_modal_frequency'];

    if (isset($field_modal_scroll_delay)) {
      $field_modal_scroll_delay['widget']['#states'] = [
        'visible' => [
          'select[name*="[field_modal_trigger]"]' => ['value' => 'scroll'],
        ],
      ];
    }

    if (isset($field_modal_timer_delay)) {
      $field_modal_timer_delay['widget']['#states'] = [
        'visible' => [
          'select[name*="[field_modal_trigger]"]' => ['value' => 'timer'],
        ],
      ];
    }

    if (isset($field_modal_banish_text)) {
      $field_modal_banish_text['widget'][0]['value']['#states'] = [
        'visible' => [
          'select[name*="[field_modal_frequency]"]' => ['!value' => -1],
          'or',
          'select[name*="[field_modal_trigger]"]' => ['!value' => 'manual']
        ]
      ];
    }

    if (isset($field_modal_frequency)) {
      $field_modal_frequency['widget']['#states'] = [
        'visible' => [
          'select[name*="[field_modal_trigger]"]' => ['!value' => 'manual'],
        ],
      ];
    }
  }
}

/**
 * Implements hook_theme_suggestions_block_alter().
 */
function s360_toolkit_custom_modal_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_bundle = $variables['elements']['content']['#block_content']->bundle();

    if ($block_bundle === 'modal') {
      $suggestions[] = 'block__custom__modal';
    }
  }
}
