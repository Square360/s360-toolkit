{%
  set classes = [
    'layout',
    'layout--four-column',
  ]
%}
{% if content %}
  <section{{ attributes.addClass(classes) }}>
    <div {{ region_attributes.first }} class="layout__region layout__region--first">
      {{ content.first }}
    </div>

    <div {{ region_attributes.second }} class="layout__region layout__region--second">
      {{ content.second }}
    </div>

    <div {{ region_attributes.third }} class="layout__region layout__region--third">
      {{ content.third }}
    </div>

    <div {{ region_attributes.fourth }} class="layout__region layout__region--fourth">
      {{ content.fourth }}
    </div>
  </section>
{% endif %}
