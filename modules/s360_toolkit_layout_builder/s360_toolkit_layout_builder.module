<?php

/**
 * @file
 * s360_tools_layouts.module
 */

/**
 * Implements hook_layout_alter().
 */
function s360_toolkit_layout_builder_layout_alter(&$definitions) {
  $layouts_to_hide = [
    // Remove default layout from layout_builder module.
    'layout_twocol_section',
    'layout_threecol_section',
    'layout_fourcol_section',
    // Remove default layout from layout_discovery module.
    'layout_onecol',
    'layout_twocol',
    'layout_twocol_bricks',
    'layout_threecol_25_50_25',
    'layout_threecol_33_34_33',
  ];

  foreach ($definitions as $definition) {
    if (in_array($definition->id(), $layouts_to_hide)) {
      unset($definitions[$definition->id()]);
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function s360_toolkit_layout_builder_page_attachments_alter(array &$attachments) {
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    $attachments['#attached']['library'][] = 's360_toolkit_layout_builder/s360_toolkit_layout_builder.admin';
  }
}

/**
 * Implements hook_preprocess_paragraph__layout_section().
 */
function s360_toolkit_layout_builder_preprocess_paragraph__layout_section(&$variables) {
  $elements = $variables['elements'];

  if (isset($elements['#paragraph'])) {
    /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
    $paragraph = $elements['#paragraph'];

    if (!\Drupal::service('router.admin_context')->isAdminRoute()) {
      if ($paragraph->hasField('field_header')) {
        $field_header = $paragraph->get('field_header');

        if (!$field_header->isEmpty()) {
          $header = $field_header->view([
            'label' => 'hidden',
          ]);

          $variables['content']['regions']['custom']['header'] = $header;
        }
      }
    }
  }
}

/**
 * Implements hook_theme_registry_alter().
 */
function s360_toolkit_layout_builder_theme_registry_alter(&$theme_registry) {
  if (isset($theme_registry['paragraph__layout_section'])) {
    $theme_registry['paragraph__layout_section']['path'] = drupal_get_path('module', 's360_toolkit_layout_builder') . '/templates';
    $theme_registry['paragraph__layout_section']['template'] = 'paragraph--layout-section';
  }
}
