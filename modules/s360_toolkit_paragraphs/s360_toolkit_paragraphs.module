<?php

/**
 * @file
 * s360_toolkit_paragraphs.module
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_help().
 */
function s360_toolkit_paragraphs_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.s360_toolkit_paragraphs':
      $output = '';

      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module adds commonly used paragraphs types.') . '</p>';

      $output .= '<h3>' . t('Paragraphs') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Header') . '</li>';
      $output .= '<li>' . t('HTML Content') . '</li>';
      $output .= '<li>' . t('Image') . '</li>';
      $output .= '<li>' . t('Video') . '</li>';
      $output .= '<li>' . t('View Block') . '</li>';
      $output .= '<li>' . t('Webform') . '</li>';
      $output .= '</ul>';

      return $output;
  }
}

/**
 * Implements hook_help().
 */
function s360_toolkit_paragraphs_preprocess_paragraphs(&$variables) {
  $elements = $variables['elements'];

  if (isset($elements['#paragraph'])) {
    /** @var \Drupal\paragraph\Entity\Paragraph $paragraph */
    $paragraph = $elements['#paragraph'];
    $paragraph_bundle = $paragraph->bundle();

    
    $variables['attributes']['id'] = 'paragraph-' . Html::getClass($paragraph_bundle). '-' . $paragraph->id();
    $variables['attributes']['class'] = [];
    $variables['attributes']['data-paragraph-' . Html::getClass($paragraph_bundle)] = '';
  }
}
