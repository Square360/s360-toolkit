<?php

/**
 * @file
 * s360_toolkit_header_field.module
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function s360_toolkit_header_field_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.s360_toolkit_header_field':
      $output = '';

      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module provides a custom header field also corresponding widget and formatters.') . '</p>';

      $output .= '<h3>' . t('Formatters') . '</h3>';
      $output .= '<h4>' . t('Header Group') . '</h4>';
      $output .= '<p>' . t('This formatter is the default and creates the HTML markup for the header.') . '</p>';
      $output .= '<h5>' . t('OUTPUT') . '</h5>';
      $output .= '<code>';
      $output .= '&lt;header class="header-group"&gt;<br />';
      $output .= '&nbsp;&nbsp;&lt;h2 class="header-group__heading"&gt;<br />';
      $output .= '&nbsp;&nbsp;&nbsp;&nbsp;&lt;a href="optional-link" class="header-group__link"&gt;Heading Text&lt;/a&gt;<br />';
      $output .= '&nbsp;&nbsp;&lt;/h2&gt;<br />';
      $output .= '&nbsp;&nbsp;&lt;div class="header-group__subtitle"&gt;Optional Subtitle&lt;/div&gt;<br />';
      $output .= '&lt;/header&gt;';
      $output .= '</code>';
      $output .= '<h4>' . t('Heading Text (Plain text)') . '</h4>';
      $output .= '<p>' . t('This formatter is typically used in "preview" display modes.') . '</p>';
      $output .= '<h5>' . t('OUTPUT') . '</h5>';
      $output .= '<code>Heading Text</code>';

      $output .= '<h3>' . t('Classes') . '</h3>';
      $output .= '<p>' . t('The following are the built-in classes that are available for styling.') . '</p>';
      $output .= '<p>' . t('NOTE: All styles must be provided from the Drupal theme.') . '</p>';

      $output .= '<ul>';
      $output .= '<li>.header-group--centered</li>';
      $output .= '<li>.header-group--uppercase</li>';
      $output .= '<li>.header-group--heading-2</li>';
      $output .= '<li>.header-group--heading-3</li>';
      $output .= '<li>.header-group--heading-4</li>';
      $output .= '<li>.header-group--heading-5</li>';
      $output .= '<li>.header-group--heading-6</li>';
      $output .= '</ul>';

      $output .= '<ul>';
      $output .= '<li>.header-group__heading</li>';
      $output .= '<li>.header-group__subtitle</li>';
      $output .= '<li>.header-group__link</li>';
      $output .= '</ul>';

      return $output;
  }
}
